<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#f97316" />
  <title>Bodywork — Autobody Estimate &amp; Invoice Software</title>
  <link rel="stylesheet" href="/public/styles.css" />
  <link rel="icon" href="/public/icon.svg" type="image/svg+xml" />
  <style>
    body { padding-bottom: 0; }
    .hero-wrap { position: relative; overflow: hidden; }
    #starfield { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; z-index: 0; }
    .hero { position: relative; z-index: 1; }

    /* ── Nav ──────────────────────────────────────────────────── */
    .land-nav {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 1rem 2rem;
      position: sticky;
      top: 0;
      z-index: 100;
      background: rgba(26,26,26,0.75);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      border-bottom: 1px solid rgba(255,255,255,0.06);
    }
    .land-logo img { display: block; border-radius: 6px; }

    /* ── Hero ─────────────────────────────────────────────────── */
    .hero {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 3rem;
      max-width: 1080px;
      margin: 0 auto;
      padding: 6rem 2rem 5rem;
      align-items: center;
    }
    @media (max-width: 720px) {
      .hero {
        grid-template-columns: 1fr;
        padding: 3rem 1.5rem 4rem;
        text-align: center;
      }
      .hero-visual { order: -1; }
      .hero-chips { justify-content: center; }
      .hero-ctas { justify-content: center; }
    }

    .hero-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      background: color-mix(in srgb, var(--accent) 12%, transparent);
      border: 1px solid color-mix(in srgb, var(--accent) 35%, transparent);
      color: var(--accent);
      border-radius: 99px;
      padding: 0.3rem 0.85rem;
      font-size: 0.78rem;
      font-weight: 700;
      letter-spacing: 0.03em;
      text-transform: uppercase;
      margin-bottom: 1.5rem;
    }

    .hero-headline {
      font-size: clamp(2rem, 3.5vw, 2.9rem);
      font-weight: 800;
      line-height: 1.15;
      margin-bottom: 1.25rem;
      letter-spacing: -0.02em;
    }
    .hero-headline em {
      font-style: normal;
      color: var(--accent);
    }

    .hero-sub {
      font-size: 1.05rem;
      color: var(--text-muted);
      line-height: 1.75;
      margin-bottom: 2.25rem;
      max-width: 460px;
    }

    .hero-ctas {
      display: flex;
      gap: 0.875rem;
      flex-wrap: wrap;
      margin-bottom: 2rem;
    }
    .hero-ctas .btn { min-width: 160px; justify-content: center; }

    .hero-chips {
      display: flex;
      gap: 1.25rem;
      flex-wrap: wrap;
      font-size: 0.78rem;
      color: var(--text-muted);
    }
    .hero-chip {
      display: flex;
      align-items: center;
      gap: 0.35rem;
    }
    .hero-chip-dot {
      width: 6px; height: 6px;
      border-radius: 50%;
      background: var(--success);
      flex-shrink: 0;
    }

    /* ── Visual / Logo side ───────────────────────────────────── */
    .hero-visual {
      display: flex;
      justify-content: center;
      align-items: center;
      position: relative;
    }
    .hero-glow {
      position: absolute;
      width: 380px;
      height: 380px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(249,115,22,0.22) 0%, rgba(249,115,22,0.06) 50%, transparent 72%);
      pointer-events: none;
    }
    .hero-mockup {
      position: relative;
      border-radius: 14px;
      overflow: hidden;
      border: 1.5px solid transparent;
      background:
        linear-gradient(#1a1a1a, #1a1a1a) padding-box,
        conic-gradient(
          from var(--border-angle, 210deg),
          rgba(249,115,22,0.7)  0deg,
          rgba(249,115,22,0.15) 50deg,
          rgba(255,255,255,0.05) 130deg,
          rgba(255,255,255,0.02) 200deg,
          rgba(255,255,255,0.05) 270deg,
          rgba(249,115,22,0.15) 330deg,
          rgba(249,115,22,0.7)  360deg
        ) border-box;
      box-shadow:
        0 28px 80px rgba(0,0,0,0.6),
        0 0 60px rgba(249,115,22,0.14);
      width: 100%;
      max-width: 420px;
      will-change: transform;
    }
    .hero-mockup img { display: block; width: 100%; height: auto; }

    /* Floating accent dots */
    .hero-dot {
      position: absolute;
      border-radius: 50%;
      background: var(--accent);
      opacity: 0.55;
      pointer-events: none;
    }

    /* ── Features ─────────────────────────────────────────────── */
    .land-features-wrap {
      max-width: 1080px;
      margin: 0 auto 5rem;
      padding: 0 2rem;
    }
    .land-features-heading {
      text-align: center;
      font-size: 1.5rem;
      font-weight: 800;
      margin-bottom: 0.5rem;
      letter-spacing: -0.02em;
    }
    .land-features-sub {
      text-align: center;
      color: var(--text-muted);
      font-size: 0.95rem;
      margin-bottom: 2.5rem;
    }
    .land-features {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 1.25rem;
    }
    .land-feature {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 1.5rem;
      transition: border-color 0.2s;
    }
    .land-feature:hover { border-color: color-mix(in srgb, var(--accent) 40%, transparent); }
    .land-feature-icon {
      width: 40px; height: 40px;
      border-radius: 10px;
      background: color-mix(in srgb, var(--accent) 12%, transparent);
      display: flex; align-items: center; justify-content: center;
      font-size: 1.2rem;
      margin-bottom: 1rem;
    }
    .land-feature h3 { font-size: 0.95rem; font-weight: 700; margin-bottom: 0.4rem; }
    .land-feature p  { font-size: 0.875rem; color: var(--text-muted); line-height: 1.55; }

    /* ── Pricing ──────────────────────────────────────────────── */
    .land-pricing {
      max-width: 720px;
      margin: 0 auto 6rem;
      padding: 0 1.5rem;
    }
    .land-pricing h2 {
      text-align: center;
      font-size: 1.6rem;
      font-weight: 800;
      margin-bottom: 0.4rem;
      letter-spacing: -0.02em;
    }
    .land-pricing-sub {
      text-align: center;
      color: var(--text-muted);
      font-size: 0.9rem;
      margin-bottom: 2.5rem;
    }
    .pricing-cards { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }
    @media (max-width: 540px) { .pricing-cards { grid-template-columns: 1fr; } }

    .pricing-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 2rem 1.5rem;
    }
    .pricing-card.featured {
      border-color: var(--accent);
      background: color-mix(in srgb, var(--accent) 5%, var(--surface));
      position: relative;
    }
    .pricing-badge {
      position: absolute;
      top: -0.75rem; left: 50%;
      transform: translateX(-50%);
      background: var(--accent);
      color: #fff;
      font-size: 0.72rem;
      font-weight: 700;
      padding: 0.2rem 0.85rem;
      border-radius: 99px;
      white-space: nowrap;
    }
    .pricing-card h3 { font-size: 1rem; font-weight: 700; margin-bottom: 0.4rem; }
    .pricing-price { font-size: 2.25rem; font-weight: 800; color: var(--accent); margin-bottom: 0.2rem; }
    .pricing-price span { font-size: 1rem; font-weight: 400; color: var(--text-muted); }
    .pricing-desc { font-size: 0.85rem; color: var(--text-muted); margin-bottom: 1.5rem; }
    .pricing-features { list-style: none; margin-bottom: 1.75rem; }
    .pricing-features li {
      font-size: 0.875rem;
      padding: 0.35rem 0;
      border-bottom: 1px solid var(--surface-2);
      display: flex; gap: 0.5rem; align-items: flex-start;
    }
    .pricing-features li:last-child { border-bottom: none; }
    .check { color: var(--success); flex-shrink: 0; }
    .cross { color: var(--text-muted); flex-shrink: 0; }

    /* ── Footer ───────────────────────────────────────────────── */
    .land-footer {
      text-align: center;
      padding: 2.5rem 1.5rem;
      border-top: 1px solid var(--border);
      color: var(--text-muted);
      font-size: 0.8rem;
    }
  </style>
</head>
<body>

<!-- Nav -->
<nav class="land-nav">
  <a href="/" style="display:flex;align-items:center;text-decoration:none;">
    <span class="wordmark" style="font-size:1.6rem;">
      <span class="wordmark-body">BODY</span><span class="wordmark-work">WORK</span>
    </span>
  </a>
  <div style="display:flex;gap:0.75rem;">
    <a href="/signup" class="btn btn-primary btn-sm">Get Started Free</a>
    <a href="/login" class="btn btn-ghost btn-sm">Sign In</a>
  </div>
</nav>

<!-- Hero -->
<div class="hero-wrap">
<canvas id="starfield"></canvas>
<section class="hero">

  <!-- Left: copy -->
  <div class="hero-text">
    <div class="hero-badge">&#9881; Built for the shop floor</div>

    <h1 class="hero-headline">
      Estimates &amp; invoices,<br>
      <em>done right.</em>
    </h1>

    <p class="hero-sub">
      Write professional repair estimates, convert them to invoices in one click,
      and share them with customers — all from your phone or desktop.
    </p>

    <div class="hero-ctas">
      <a href="/signup" class="btn btn-primary">Get Started Free</a>
      <a href="#pricing" class="btn btn-ghost">See Pricing</a>
    </div>

    <div class="hero-chips">
      <span class="hero-chip">
        <span class="hero-chip-dot"></span>
        No credit card required
      </span>
      <span class="hero-chip">
        <span class="hero-chip-dot"></span>
        Free plan available
      </span>
      <span class="hero-chip">
        <span class="hero-chip-dot"></span>
        Works on mobile
      </span>
    </div>
  </div>

  <!-- Right: logo visual -->
  <div class="hero-visual">
    <div class="hero-glow"></div>

    <!-- floating accent dots -->
    <div class="hero-dot" style="width:10px;height:10px;top:10%;right:12%;"></div>
    <div class="hero-dot" style="width:6px;height:6px;bottom:18%;left:8%;opacity:0.35;"></div>
    <div class="hero-dot" style="width:8px;height:8px;top:55%;right:6%;opacity:0.4;"></div>

    <div class="hero-mockup">
      <img src="/public/estimate-mockup.svg" alt="Estimate mockup showing line items for a 2021 Toyota Camry repair" width="440" height="500" style="display:block;width:100%;height:auto;" />
    </div>
  </div>

</section>
</div>

<!-- Features -->
<div class="land-features-wrap">
  <h2 class="land-features-heading">Everything your shop needs</h2>
  <p class="land-features-sub">From first estimate to final invoice — all in one place.</p>
  <div class="land-features">
    <div class="land-feature">
      <div class="land-feature-icon" aria-hidden="true">&#128203;</div>
      <h3>Fast Estimates</h3>
      <p>Labor, parts, paint, and sublet line items. Tax and totals calculated automatically.</p>
    </div>
    <div class="land-feature">
      <div class="land-feature-icon" aria-hidden="true">&#128196;</div>
      <h3>One-Click Invoicing</h3>
      <p>Convert an approved estimate to an invoice in seconds — no re-entering data.</p>
    </div>
    <div class="land-feature">
      <div class="land-feature-icon" aria-hidden="true">&#128279;</div>
      <h3>Shareable Links</h3>
      <p>Send customers a read-only link to their estimate or invoice — no login needed.</p>
    </div>
    <div class="land-feature">
      <div class="land-feature-icon" aria-hidden="true">&#128241;</div>
      <h3>Mobile-First</h3>
      <p>Built for the shop floor. Installable as a PWA for instant access from your home screen.</p>
    </div>
  </div>
</div>

<!-- Pricing -->
<section class="land-pricing" id="pricing">
  <h2>Simple pricing</h2>
  <p class="land-pricing-sub">Start free, upgrade when you're ready.</p>
  <div class="pricing-cards">
    <div class="pricing-card">
      <h3>Free</h3>
      <div class="pricing-price">$0 <span>/ mo</span></div>
      <p class="pricing-desc">Perfect for getting started.</p>
      <ul class="pricing-features">
        <li><span class="check">&#10003;</span> 3 estimates / month</li>
        <li><span class="check">&#10003;</span> Customer management</li>
        <li><span class="check">&#10003;</span> Shareable estimate links</li>
        <li><span class="cross">&#215;</span> Invoicing</li>
        <li><span class="cross">&#215;</span> Unlimited estimates</li>
        <li><span class="cross">&#215;</span> Client history</li>
      </ul>
      <a href="/signup" class="btn btn-ghost" style="width:100%;justify-content:center;">Start Free</a>
    </div>
    <div class="pricing-card featured">
      <span class="pricing-badge">Most Popular</span>
      <h3>Pro</h3>
      <div class="pricing-price">$29 <span>/ mo</span></div>
      <p class="pricing-desc">Everything you need to run your shop.</p>
      <ul class="pricing-features">
        <li><span class="check">&#10003;</span> Unlimited estimates</li>
        <li><span class="check">&#10003;</span> Customer management</li>
        <li><span class="check">&#10003;</span> Shareable links</li>
        <li><span class="check">&#10003;</span> Full invoicing</li>
        <li><span class="check">&#10003;</span> Client history &amp; search</li>
        <li><span class="check">&#10003;</span> Custom shop branding</li>
      </ul>
      <a href="/signup" class="btn btn-primary" style="width:100%;justify-content:center;">Get Started</a>
    </div>
  </div>
</section>

<footer class="land-footer">
  &copy; <%= new Date().getFullYear() %> Bodywork &mdash; Estimates. Invoices. Done Right.<br>
  <span style="font-size:0.75rem;">
    Developed by <a href="https://darrickdevelops.com" target="_blank" rel="noopener" style="color:var(--text-muted);">Darrick Develops</a>
    &middot; <a href="/privacy" style="color:var(--text-muted);">Privacy Policy</a>
  </span>
</footer>

<script>
(function () {
  if (!window.matchMedia('(hover: hover)').matches) return;

  const mockup = document.querySelector('.hero-mockup');
  const glow   = document.querySelector('.hero-glow');
  const dots   = document.querySelectorAll('.hero-dot');
  if (!mockup) return;

  const entranceStart = performance.now();
  const entranceDur   = 900;
  let curX = 16, curY = -24, tgtX = 0, tgtY = 0;

  window.addEventListener('mousemove', function (e) {
    const nx = (e.clientX / window.innerWidth  - 0.5) * 2;
    const ny = (e.clientY / window.innerHeight - 0.5) * 2;
    tgtY =  nx * 18;
    tgtX = -ny * 12;

    const rect = mockup.getBoundingClientRect();
    const bAngle = Math.atan2(
      e.clientX - (rect.left + rect.width  / 2),
     -(e.clientY - (rect.top  + rect.height / 2))
    ) * 180 / Math.PI;
    mockup.style.setProperty('--border-angle', bAngle + 'deg');
  });

  document.documentElement.addEventListener('mouseleave', function () {
    tgtX = 0; tgtY = 0;
  });

  function tick() {
    curX += (tgtX - curX) * 0.07;
    curY += (tgtY - curY) * 0.07;

    const t    = Math.min((performance.now() - entranceStart) / entranceDur, 1);
    const ease = 1 - Math.pow(1 - t, 3);
    const ty   = ((1 - ease) * 40).toFixed(1);

    mockup.style.transform =
      'perspective(2000px) rotateX(' + curX.toFixed(3) + 'deg) rotateY(' + curY.toFixed(3) + 'deg) translateY(' + ty + 'px)';

    var now = performance.now() / 1000;
    var gx = (curY * 1.8).toFixed(2);
    var gy = (curX * -1.8).toFixed(2);
    if (glow) {
      var glowScale = (1 + 0.06 * Math.sin(now * 0.55)).toFixed(4);
      glow.style.transform = 'translate(' + gx + 'px,' + gy + 'px) scale(' + glowScale + ')';
      glow.style.opacity    = (0.8 + 0.2 * Math.sin(now * 0.4)).toFixed(3);
    }

    dots.forEach(function (d, i) {
      var f  = (i + 1) * 0.55;
      var fx = (curY * f + Math.cos(now * 0.6 + i * 2.1) * 4).toFixed(2);
      var fy = (-curX * f * 0.6 + Math.sin(now * 0.5 + i * 1.5) * 5).toFixed(2);
      d.style.transform = 'translate(' + fx + 'px,' + fy + 'px)';
    });

    var sx = (-curY * 0.6).toFixed(1);
    var sy = ( curX * 0.6).toFixed(1);
    var orange = (0.14 + Math.min(Math.abs(curX) + Math.abs(curY), 20) * 0.004).toFixed(3);
    mockup.style.boxShadow =
      sx + 'px ' + (parseFloat(sy) + 28) + 'px 80px rgba(0,0,0,0.65),' +
      '0 0 60px rgba(249,115,22,' + orange + ')';

    requestAnimationFrame(tick);
  }
  tick();
}());

(function () {
  var canvas  = document.getElementById('starfield');
  if (!canvas) return;
  var ctx     = canvas.getContext('2d');
  var mockupEl = document.querySelector('.hero-mockup');
  var W, H, cx, cy;
  var N = 60;
  var SPEED = 0.18;

  function resize() {
    var p = canvas.parentElement;
    W = canvas.width  = p.offsetWidth;
    H = canvas.height = p.offsetHeight;
    if (mockupEl) {
      var mr = mockupEl.getBoundingClientRect();
      var pr = p.getBoundingClientRect();
      cx = mr.left - pr.left + mr.width  / 2;
      cy = mr.top  - pr.top  + mr.height / 2;
    } else {
      cx = W / 2; cy = H / 2;
    }
  }
  resize();
  window.addEventListener('resize', resize);

  function mkStar(fresh) {
    var angle = Math.random() * Math.PI * 2;
    var spread = fresh ? 20 : Math.random() * 120;
    return {
      x: Math.cos(angle) * spread,
      y: Math.sin(angle) * spread,
      z: fresh ? 0.9 + Math.random() * 0.1 : Math.random(),
      tint: Math.random(),
    };
  }

  var stars = [];
  for (var i = 0; i < N; i++) stars.push(mkStar(false));

  function draw() {
    ctx.fillStyle = 'rgba(26,26,26,0.45)';
    ctx.fillRect(0, 0, W, H);

    for (var i = 0; i < N; i++) {
      var s = stars[i];
      s.z -= SPEED * 0.002;

      var sx = (s.x / s.z) + cx;
      var sy = (s.y / s.z) + cy;

      if (s.z <= 0.02 || sx < -20 || sx > W + 20 || sy < -20 || sy > H + 20) {
        stars[i] = mkStar(true);
        continue;
      }

      var progress = 1 - s.z;
      var radius   = 0.4 + progress * 2.2;
      var alpha    = Math.min(progress * progress * progress * 4, 0.6);

      ctx.beginPath();
      ctx.arc(sx, sy, radius, 0, 6.2832);
      var r = 245 + Math.round(s.tint * 10);
      var g = 60  + Math.round(s.tint * 55);
      ctx.fillStyle = 'rgba(' + r + ',' + g + ',18,' + alpha + ')';
      ctx.fill();
    }

    requestAnimationFrame(draw);
  }
  draw();
}());
</script>

</body>
</html>
