<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#f97316" />
  <title>Bodywork — Autobody Estimate &amp; Invoice Software</title>
  <link rel="stylesheet" href="/public/styles.css" />
  <link rel="icon" href="/public/icon.svg" type="image/svg+xml" />
  <style>
    body { padding-bottom: 0; }

    /* ── Nav ──────────────────────────────────────────────────── */
    .land-nav {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 1rem 2rem;
      position: sticky;
      top: 0;
      z-index: 100;
      background: rgba(26,26,26,0.75);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      border-bottom: 1px solid rgba(255,255,255,0.06);
    }
    .land-logo img { display: block; border-radius: 6px; }

    /* ── Hero ─────────────────────────────────────────────────── */
    .hero {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 3rem;
      max-width: 1080px;
      margin: 0 auto;
      padding: 6rem 2rem 5rem;
      align-items: center;
    }
    @media (max-width: 720px) {
      .hero {
        grid-template-columns: 1fr;
        padding: 3rem 1.5rem 4rem;
        text-align: center;
      }
      .hero-visual { order: -1; }
      .hero-chips { justify-content: center; }
      .hero-ctas { justify-content: center; }
    }

    .hero-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      background: color-mix(in srgb, var(--accent) 12%, transparent);
      border: 1px solid color-mix(in srgb, var(--accent) 35%, transparent);
      color: var(--accent);
      border-radius: 99px;
      padding: 0.3rem 0.85rem;
      font-size: 0.78rem;
      font-weight: 700;
      letter-spacing: 0.03em;
      text-transform: uppercase;
      margin-bottom: 1.5rem;
    }

    .hero-headline {
      font-size: clamp(2rem, 3.5vw, 2.9rem);
      font-weight: 800;
      line-height: 1.15;
      margin-bottom: 1.25rem;
      letter-spacing: -0.02em;
    }
    .hero-headline em {
      font-style: normal;
      color: var(--accent);
    }

    .hero-sub {
      font-size: 1.05rem;
      color: var(--text-muted);
      line-height: 1.75;
      margin-bottom: 2.25rem;
      max-width: 460px;
    }

    .hero-ctas {
      display: flex;
      gap: 0.875rem;
      flex-wrap: wrap;
      margin-bottom: 2rem;
    }
    .hero-ctas .btn { min-width: 160px; justify-content: center; }

    .hero-chips {
      display: flex;
      gap: 1.25rem;
      flex-wrap: wrap;
      font-size: 0.78rem;
      color: var(--text-muted);
    }
    .hero-chip {
      display: flex;
      align-items: center;
      gap: 0.35rem;
    }
    .hero-chip-dot {
      width: 6px; height: 6px;
      border-radius: 50%;
      background: var(--success);
      flex-shrink: 0;
    }

    /* ── Visual / Logo side ───────────────────────────────────── */
    .hero-visual {
      display: flex;
      justify-content: center;
      align-items: center;
      position: relative;
    }
    .hero-glow {
      position: absolute;
      width: 380px;
      height: 380px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(249,115,22,0.22) 0%, rgba(249,115,22,0.06) 50%, transparent 72%);
      pointer-events: none;
    }
    .hero-mockup {
      position: relative;
      border-radius: 14px;
      overflow: hidden;
      box-shadow:
        0 0 0 1px rgba(255,255,255,0.07),
        0 28px 80px rgba(0,0,0,0.6),
        0 0 60px rgba(249,115,22,0.14);
      width: 100%;
      max-width: 420px;
    }
    .hero-mockup svg { display: block; width: 100%; }

    /* Floating accent dots */
    .hero-dot {
      position: absolute;
      border-radius: 50%;
      background: var(--accent);
      opacity: 0.55;
      pointer-events: none;
    }

    /* ── Features ─────────────────────────────────────────────── */
    .land-features-wrap {
      max-width: 1080px;
      margin: 0 auto 5rem;
      padding: 0 2rem;
    }
    .land-features-heading {
      text-align: center;
      font-size: 1.5rem;
      font-weight: 800;
      margin-bottom: 0.5rem;
      letter-spacing: -0.02em;
    }
    .land-features-sub {
      text-align: center;
      color: var(--text-muted);
      font-size: 0.95rem;
      margin-bottom: 2.5rem;
    }
    .land-features {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 1.25rem;
    }
    .land-feature {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 1.5rem;
      transition: border-color 0.2s;
    }
    .land-feature:hover { border-color: color-mix(in srgb, var(--accent) 40%, transparent); }
    .land-feature-icon {
      width: 40px; height: 40px;
      border-radius: 10px;
      background: color-mix(in srgb, var(--accent) 12%, transparent);
      display: flex; align-items: center; justify-content: center;
      font-size: 1.2rem;
      margin-bottom: 1rem;
    }
    .land-feature h3 { font-size: 0.95rem; font-weight: 700; margin-bottom: 0.4rem; }
    .land-feature p  { font-size: 0.875rem; color: var(--text-muted); line-height: 1.55; }

    /* ── Pricing ──────────────────────────────────────────────── */
    .land-pricing {
      max-width: 720px;
      margin: 0 auto 6rem;
      padding: 0 1.5rem;
    }
    .land-pricing h2 {
      text-align: center;
      font-size: 1.6rem;
      font-weight: 800;
      margin-bottom: 0.4rem;
      letter-spacing: -0.02em;
    }
    .land-pricing-sub {
      text-align: center;
      color: var(--text-muted);
      font-size: 0.9rem;
      margin-bottom: 2.5rem;
    }
    .pricing-cards { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }
    @media (max-width: 540px) { .pricing-cards { grid-template-columns: 1fr; } }

    .pricing-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 2rem 1.5rem;
    }
    .pricing-card.featured {
      border-color: var(--accent);
      background: color-mix(in srgb, var(--accent) 5%, var(--surface));
      position: relative;
    }
    .pricing-badge {
      position: absolute;
      top: -0.75rem; left: 50%;
      transform: translateX(-50%);
      background: var(--accent);
      color: #fff;
      font-size: 0.72rem;
      font-weight: 700;
      padding: 0.2rem 0.85rem;
      border-radius: 99px;
      white-space: nowrap;
    }
    .pricing-card h3 { font-size: 1rem; font-weight: 700; margin-bottom: 0.4rem; }
    .pricing-price { font-size: 2.25rem; font-weight: 800; color: var(--accent); margin-bottom: 0.2rem; }
    .pricing-price span { font-size: 1rem; font-weight: 400; color: var(--text-muted); }
    .pricing-desc { font-size: 0.85rem; color: var(--text-muted); margin-bottom: 1.5rem; }
    .pricing-features { list-style: none; margin-bottom: 1.75rem; }
    .pricing-features li {
      font-size: 0.875rem;
      padding: 0.35rem 0;
      border-bottom: 1px solid var(--surface-2);
      display: flex; gap: 0.5rem; align-items: flex-start;
    }
    .pricing-features li:last-child { border-bottom: none; }
    .check { color: var(--success); flex-shrink: 0; }
    .cross { color: var(--text-muted); flex-shrink: 0; }

    /* ── Footer ───────────────────────────────────────────────── */
    .land-footer {
      text-align: center;
      padding: 2.5rem 1.5rem;
      border-top: 1px solid var(--border);
      color: var(--text-muted);
      font-size: 0.8rem;
    }
  </style>
</head>
<body>

<!-- Nav -->
<nav class="land-nav">
  <a href="/" style="display:flex;align-items:center;text-decoration:none;">
    <span class="wordmark" style="font-size:1.2rem;">
      <span class="wordmark-body">BODY</span><span class="wordmark-work">WORK</span>
    </span>
  </a>
  <div style="display:flex;gap:0.75rem;">
    <a href="/signup" class="btn btn-primary btn-sm">Get Started Free</a>
    <a href="/login" class="btn btn-ghost btn-sm">Sign In</a>
  </div>
</nav>

<!-- Hero -->
<section class="hero">

  <!-- Left: copy -->
  <div class="hero-text">
    <div class="hero-badge">&#9881; Built for the shop floor</div>

    <h1 class="hero-headline">
      Estimates &amp; invoices,<br>
      <em>done right.</em>
    </h1>

    <p class="hero-sub">
      Write professional repair estimates, convert them to invoices in one click,
      and share them with customers — all from your phone or desktop.
    </p>

    <div class="hero-ctas">
      <a href="/signup" class="btn btn-primary">Get Started Free</a>
      <a href="#pricing" class="btn btn-ghost">See Pricing</a>
    </div>

    <div class="hero-chips">
      <span class="hero-chip">
        <span class="hero-chip-dot"></span>
        No credit card required
      </span>
      <span class="hero-chip">
        <span class="hero-chip-dot"></span>
        Free plan available
      </span>
      <span class="hero-chip">
        <span class="hero-chip-dot"></span>
        Works on mobile
      </span>
    </div>
  </div>

  <!-- Right: logo visual -->
  <div class="hero-visual">
    <div class="hero-glow"></div>

    <!-- floating accent dots -->
    <div class="hero-dot" style="width:10px;height:10px;top:10%;right:12%;"></div>
    <div class="hero-dot" style="width:6px;height:6px;bottom:18%;left:8%;opacity:0.35;"></div>
    <div class="hero-dot" style="width:8px;height:8px;top:55%;right:6%;opacity:0.4;"></div>

    <div class="hero-mockup">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 440 500" role="img" aria-label="Estimate mockup showing line items for a 2021 Toyota Camry repair">

        <!-- Card background -->
        <rect width="440" height="500" fill="#252525"/>

        <!-- Window chrome -->
        <rect width="440" height="38" fill="#1a1a1a"/>
        <circle cx="20" cy="19" r="5" fill="#f87171"/>
        <circle cx="37" cy="19" r="5" fill="#fbbf24"/>
        <circle cx="54" cy="19" r="5" fill="#4ade80"/>
        <rect x="78" y="8" width="150" height="22" rx="4" fill="#2e2e2e"/>
        <text x="153" y="23" text-anchor="middle" fill="#6b7280" font-size="11" font-family="system-ui,Arial,sans-serif">Estimate Details</text>

        <!-- Orange left accent stripe -->
        <rect x="0" y="38" width="4" height="96" fill="#f97316"/>

        <!-- Status badge -->
        <rect x="330" y="50" width="94" height="22" rx="11" fill="#14532d"/>
        <text x="377" y="65" text-anchor="middle" fill="#4ade80" font-size="10" font-weight="700" font-family="system-ui,Arial,sans-serif">&#10003; APPROVED</text>

        <!-- Estimate ID -->
        <text x="20" y="62" fill="#6b7280" font-size="10" font-weight="600" font-family="system-ui,Arial,sans-serif" letter-spacing="1">ESTIMATE</text>
        <text x="20" y="83" fill="#f5f5f5" font-size="17" font-weight="700" font-family="system-ui,Arial,sans-serif">#EST-2024-0047</text>

        <!-- Customer + vehicle -->
        <text x="20" y="105" fill="#f5f5f5" font-size="13" font-weight="600" font-family="system-ui,Arial,sans-serif">Maria Garcia</text>
        <text x="20" y="122" fill="#6b7280" font-size="11" font-family="system-ui,Arial,sans-serif">2021 Toyota Camry  &#183;  Front-End Collision</text>

        <!-- Date -->
        <text x="424" y="122" text-anchor="end" fill="#6b7280" font-size="11" font-family="system-ui,Arial,sans-serif">Jun 2, 2026</text>

        <!-- Divider -->
        <line x1="0" y1="134" x2="440" y2="134" stroke="#383838" stroke-width="1"/>

        <!-- Table header -->
        <rect x="0" y="134" width="440" height="26" fill="#1e1e1e"/>
        <text x="20" y="151" fill="#4b5563" font-size="9.5" font-weight="700" font-family="system-ui,Arial,sans-serif" letter-spacing="0.8">TYPE</text>
        <text x="80" y="151" fill="#4b5563" font-size="9.5" font-weight="700" font-family="system-ui,Arial,sans-serif" letter-spacing="0.8">DESCRIPTION</text>
        <text x="424" y="151" text-anchor="end" fill="#4b5563" font-size="9.5" font-weight="700" font-family="system-ui,Arial,sans-serif" letter-spacing="0.8">AMOUNT</text>

        <!-- ── Row 1: Labor ── -->
        <rect x="0" y="160" width="440" height="38" fill="#252525"/>
        <rect x="12" y="167" width="46" height="17" rx="3" fill="#172554"/>
        <text x="35" y="179" text-anchor="middle" fill="#60a5fa" font-size="9" font-weight="700" font-family="system-ui,Arial,sans-serif">LABOR</text>
        <text x="70" y="175" fill="#f5f5f5" font-size="12" font-family="system-ui,Arial,sans-serif">Front bumper R&amp;R</text>
        <text x="70" y="190" fill="#6b7280" font-size="10" font-family="system-ui,Arial,sans-serif">3.5 hrs &#215; $95.00</text>
        <text x="424" y="178" text-anchor="end" fill="#f5f5f5" font-size="12" font-weight="600" font-family="system-ui,Arial,sans-serif">$332.50</text>

        <!-- ── Row 2: Labor (alt) ── -->
        <rect x="0" y="198" width="440" height="38" fill="#2a2a2a"/>
        <rect x="12" y="205" width="46" height="17" rx="3" fill="#172554"/>
        <text x="35" y="217" text-anchor="middle" fill="#60a5fa" font-size="9" font-weight="700" font-family="system-ui,Arial,sans-serif">LABOR</text>
        <text x="70" y="213" fill="#f5f5f5" font-size="12" font-family="system-ui,Arial,sans-serif">Hood replacement</text>
        <text x="70" y="228" fill="#6b7280" font-size="10" font-family="system-ui,Arial,sans-serif">2.0 hrs &#215; $95.00</text>
        <text x="424" y="216" text-anchor="end" fill="#f5f5f5" font-size="12" font-weight="600" font-family="system-ui,Arial,sans-serif">$190.00</text>

        <!-- ── Row 3: Parts ── -->
        <rect x="0" y="236" width="440" height="38" fill="#252525"/>
        <rect x="12" y="243" width="46" height="17" rx="3" fill="#14532d"/>
        <text x="35" y="255" text-anchor="middle" fill="#4ade80" font-size="9" font-weight="700" font-family="system-ui,Arial,sans-serif">PARTS</text>
        <text x="70" y="251" fill="#f5f5f5" font-size="12" font-family="system-ui,Arial,sans-serif">Front bumper cover</text>
        <text x="70" y="266" fill="#6b7280" font-size="10" font-family="system-ui,Arial,sans-serif">1 &#215; $287.50</text>
        <text x="424" y="254" text-anchor="end" fill="#f5f5f5" font-size="12" font-weight="600" font-family="system-ui,Arial,sans-serif">$287.50</text>

        <!-- ── Row 4: Parts (alt) ── -->
        <rect x="0" y="274" width="440" height="38" fill="#2a2a2a"/>
        <rect x="12" y="281" width="46" height="17" rx="3" fill="#14532d"/>
        <text x="35" y="293" text-anchor="middle" fill="#4ade80" font-size="9" font-weight="700" font-family="system-ui,Arial,sans-serif">PARTS</text>
        <text x="70" y="289" fill="#f5f5f5" font-size="12" font-family="system-ui,Arial,sans-serif">Hood assembly</text>
        <text x="70" y="304" fill="#6b7280" font-size="10" font-family="system-ui,Arial,sans-serif">1 &#215; $645.00</text>
        <text x="424" y="292" text-anchor="end" fill="#f5f5f5" font-size="12" font-weight="600" font-family="system-ui,Arial,sans-serif">$645.00</text>

        <!-- ── Row 5: Paint ── -->
        <rect x="0" y="312" width="440" height="38" fill="#252525"/>
        <rect x="12" y="319" width="46" height="17" rx="3" fill="#431407"/>
        <text x="35" y="331" text-anchor="middle" fill="#f97316" font-size="9" font-weight="700" font-family="system-ui,Arial,sans-serif">PAINT</text>
        <text x="70" y="327" fill="#f5f5f5" font-size="12" font-family="system-ui,Arial,sans-serif">Midnight Blue basecoat/clearcoat</text>
        <text x="70" y="342" fill="#6b7280" font-size="10" font-family="system-ui,Arial,sans-serif">Hood + bumper</text>
        <text x="424" y="330" text-anchor="end" fill="#f5f5f5" font-size="12" font-weight="600" font-family="system-ui,Arial,sans-serif">$220.00</text>

        <!-- Divider before totals -->
        <line x1="0" y1="350" x2="440" y2="350" stroke="#383838" stroke-width="1"/>

        <!-- Totals section background -->
        <rect x="0" y="350" width="440" height="150" fill="#1e1e1e"/>

        <!-- Subtotal row -->
        <text x="270" y="382" fill="#6b7280" font-size="12" font-family="system-ui,Arial,sans-serif">Subtotal</text>
        <text x="424" y="382" text-anchor="end" fill="#d1d5db" font-size="12" font-family="system-ui,Arial,sans-serif">$1,675.00</text>

        <!-- Tax row -->
        <text x="270" y="408" fill="#6b7280" font-size="12" font-family="system-ui,Arial,sans-serif">Tax (8%)</text>
        <text x="424" y="408" text-anchor="end" fill="#d1d5db" font-size="12" font-family="system-ui,Arial,sans-serif">$134.00</text>

        <!-- Total divider -->
        <line x1="258" y1="420" x2="432" y2="420" stroke="#383838" stroke-width="1"/>

        <!-- Total -->
        <text x="270" y="444" fill="#f5f5f5" font-size="13" font-weight="700" font-family="system-ui,Arial,sans-serif">Total</text>
        <text x="424" y="446" text-anchor="end" fill="#f97316" font-size="20" font-weight="800" font-family="system-ui,Arial,sans-serif">$1,809.00</text>

        <!-- Action buttons -->
        <rect x="16" y="460" width="160" height="32" rx="7" fill="#f97316"/>
        <text x="96" y="481" text-anchor="middle" fill="white" font-size="11.5" font-weight="700" font-family="system-ui,Arial,sans-serif">Convert to Invoice</text>

        <rect x="186" y="460" width="96" height="32" rx="7" fill="none" stroke="#444" stroke-width="1.5"/>
        <text x="234" y="481" text-anchor="middle" fill="#9ca3af" font-size="11.5" font-family="system-ui,Arial,sans-serif">Share Link</text>

        <!-- Card border overlay -->
        <rect width="440" height="500" fill="none" stroke="#383838" stroke-width="1"/>
      </svg>
    </div>
  </div>

</section>

<!-- Features -->
<div class="land-features-wrap">
  <h2 class="land-features-heading">Everything your shop needs</h2>
  <p class="land-features-sub">From first estimate to final invoice — all in one place.</p>
  <div class="land-features">
    <div class="land-feature">
      <div class="land-feature-icon" aria-hidden="true">&#128203;</div>
      <h3>Fast Estimates</h3>
      <p>Labor, parts, paint, and sublet line items. Tax and totals calculated automatically.</p>
    </div>
    <div class="land-feature">
      <div class="land-feature-icon" aria-hidden="true">&#128196;</div>
      <h3>One-Click Invoicing</h3>
      <p>Convert an approved estimate to an invoice in seconds — no re-entering data.</p>
    </div>
    <div class="land-feature">
      <div class="land-feature-icon" aria-hidden="true">&#128279;</div>
      <h3>Shareable Links</h3>
      <p>Send customers a read-only link to their estimate or invoice — no login needed.</p>
    </div>
    <div class="land-feature">
      <div class="land-feature-icon" aria-hidden="true">&#128241;</div>
      <h3>Mobile-First</h3>
      <p>Built for the shop floor. Installable as a PWA for instant access from your home screen.</p>
    </div>
  </div>
</div>

<!-- Pricing -->
<section class="land-pricing" id="pricing">
  <h2>Simple pricing</h2>
  <p class="land-pricing-sub">Start free, upgrade when you're ready.</p>
  <div class="pricing-cards">
    <div class="pricing-card">
      <h3>Free</h3>
      <div class="pricing-price">$0 <span>/ mo</span></div>
      <p class="pricing-desc">Perfect for getting started.</p>
      <ul class="pricing-features">
        <li><span class="check">&#10003;</span> 3 estimates / month</li>
        <li><span class="check">&#10003;</span> Customer management</li>
        <li><span class="check">&#10003;</span> Shareable estimate links</li>
        <li><span class="cross">&#215;</span> Invoicing</li>
        <li><span class="cross">&#215;</span> Unlimited estimates</li>
        <li><span class="cross">&#215;</span> Client history</li>
      </ul>
      <a href="/signup" class="btn btn-ghost" style="width:100%;justify-content:center;">Start Free</a>
    </div>
    <div class="pricing-card featured">
      <span class="pricing-badge">Most Popular</span>
      <h3>Pro</h3>
      <div class="pricing-price">$29 <span>/ mo</span></div>
      <p class="pricing-desc">Everything you need to run your shop.</p>
      <ul class="pricing-features">
        <li><span class="check">&#10003;</span> Unlimited estimates</li>
        <li><span class="check">&#10003;</span> Customer management</li>
        <li><span class="check">&#10003;</span> Shareable links</li>
        <li><span class="check">&#10003;</span> Full invoicing</li>
        <li><span class="check">&#10003;</span> Client history &amp; search</li>
        <li><span class="check">&#10003;</span> Custom shop branding</li>
      </ul>
      <a href="/signup" class="btn btn-primary" style="width:100%;justify-content:center;">Get Started</a>
    </div>
  </div>
</section>

<footer class="land-footer">
  &copy; <%= new Date().getFullYear() %> Bodywork &mdash; Estimates. Invoices. Done Right.
</footer>

</body>
</html>
