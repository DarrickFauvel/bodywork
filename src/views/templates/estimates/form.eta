<div class="page-header">
  <div>
    <div class="page-title">New Estimate</div>
    <div class="page-subtitle"><a href="/admin/estimates">← Estimates</a></div>
  </div>
</div>
<div class="page-body">
  <div class="card" style="max-width:680px;">
    <form method="POST" action="/admin/estimates">
      <div class="form-row">
        <div class="form-group">
          <label for="customerId">Customer *</label>
          <select id="customerId" name="customerId" required>
            <option value="">— Select customer —</option>
            <% it.customers.forEach(c => { %>
            <option value="<%= c.id %>" <%= it.prefillCustomerId === c.id ? 'selected' : '' %>><%= c.name %></option>
            <% }) %>
          </select>
        </div>
        <div class="form-group">
          <label for="taxRate">Tax Rate (%)</label>
          <input type="number" id="taxRate" name="taxRate" step="0.1" min="0" max="100"
            value="<%= ((it.settings?.defaultTaxRate ?? 0) * 100).toFixed(1) %>" />
        </div>
      </div>
      <div class="form-group">
        <label for="title">Estimate Title *</label>
        <input type="text" id="title" name="title" required placeholder="e.g. 2019 Honda Accord — Rear Damage" />
      </div>
      <div class="form-row">
        <div class="form-group">
          <label for="vYear">Year</label>
          <input type="text" id="vYear" name="vYear" placeholder="2019" />
        </div>
        <div class="form-group">
          <label for="vMake">Make</label>
          <input type="text" id="vMake" name="vMake" placeholder="Honda" />
        </div>
        <div class="form-group">
          <label for="vModel">Model</label>
          <input type="text" id="vModel" name="vModel" placeholder="Accord" />
        </div>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label for="vColor">Color</label>
          <input type="text" id="vColor" name="vColor" placeholder="Silver" />
        </div>
        <div class="form-group">
          <label for="vVin">VIN</label>
          <input type="text" id="vVin" name="vVin" placeholder="1HGCM82633A..." />
        </div>
        <div class="form-group">
          <label for="vMileage">Mileage</label>
          <input type="text" id="vMileage" name="vMileage" placeholder="82,000" />
        </div>
      </div>
      <div class="form-group">
        <label for="notes">Notes</label>
        <textarea id="notes" name="notes" placeholder="Additional notes..."></textarea>
      </div>
      <div class="btn-group mt-2">
        <button type="submit" class="btn btn-primary">Create &amp; Add Line Items →</button>
        <a href="/admin/estimates" class="btn btn-ghost">Cancel</a>
      </div>
    </form>
  </div>
</div>
