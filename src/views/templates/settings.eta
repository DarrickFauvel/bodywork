<div class="page-header">
  <div>
    <div class="page-title">Settings</div>
    <div class="page-subtitle">Shop information &amp; defaults</div>
  </div>
</div>
<div class="page-body">
  <div class="card" style="max-width:540px;">
    <form method="POST" action="/admin/settings" enctype="multipart/form-data">
      <fieldset style="border:1px solid var(--border);border-radius:var(--radius);padding:1.25rem;margin:0 0 1.25rem;">
        <legend class="card-title" style="padding:0 0.5rem;background:var(--surface);">Shop Info</legend>
        <div class="form-group">
          <label for="shopName">Shop Name</label>
          <input type="text" id="shopName" name="shopName" value="<%= it.settings.shopName || '' %>" placeholder="My Auto Body Shop" />
        </div>
        <div class="form-row">
          <div class="form-group">
            <label for="phone">Phone</label>
            <input type="tel" id="phone" name="phone" value="<%= it.settings.phone || '' %>" />
          </div>
          <div class="form-group">
            <label for="email">Email</label>
            <input type="email" id="email" name="email" value="<%= it.settings.email || '' %>" />
          </div>
        </div>
        <div class="form-group" style="margin-bottom:0;">
          <label for="address">Address</label>
          <input type="text" id="address" name="address" value="<%= it.settings.address || '' %>" />
        </div>
      </fieldset>
      <fieldset style="border:1px solid var(--border);border-radius:var(--radius);padding:1.25rem;margin:0 0 1.25rem;">
        <legend class="card-title" style="padding:0 0.5rem;background:var(--surface);">Defaults</legend>
        <div class="form-row" style="margin-bottom:0;">
          <div class="form-group" style="margin-bottom:0;">
            <label for="defaultLaborRate">Default Labor Rate ($/hr)</label>
            <input type="number" id="defaultLaborRate" name="defaultLaborRate" step="0.01" min="0"
              value="<%= it.settings.defaultLaborRate ?? 95 %>" />
          </div>
          <div class="form-group" style="margin-bottom:0;">
            <label for="defaultTaxRate">Default Tax Rate (%)</label>
            <input type="number" id="defaultTaxRate" name="defaultTaxRate" step="0.1" min="0" max="100"
              value="<%= ((it.settings.defaultTaxRate ?? 0) * 100).toFixed(1) %>" />
          </div>
        </div>
      </fieldset>
      <% if (it.plan === 'paid') { %>
      <fieldset style="border:1px solid var(--border);border-radius:var(--radius);padding:1.25rem;margin:0 0 1.25rem;">
        <legend class="card-title" style="padding:0 0.5rem;background:var(--surface);">Branding</legend>
        <div class="form-group">
          <label>Shop Logo</label>
          <% if (it.settings.logoData) { %>
          <div style="margin-bottom:0.75rem;">
            <img src="<%= it.settings.logoData %>" alt="Shop logo" style="max-height:80px;max-width:220px;border-radius:6px;border:1px solid var(--border);" />
          </div>
          <div style="display:flex;gap:0.5rem;align-items:center;margin-bottom:0.5rem;">
            <input type="file" name="logo" accept="image/*" style="flex:1;" />
            <form method="POST" action="/admin/settings/remove-logo" style="display:inline;">
              <button type="submit" class="btn btn-ghost btn-sm" style="color:var(--danger);">Remove logo</button>
            </form>
          </div>
          <% } else { %>
          <input type="file" name="logo" accept="image/*" />
          <% } %>
          <div style="font-size:0.75rem;color:var(--text-muted);margin-top:0.25rem;">PNG, JPG, or SVG. Displayed on estimates and invoices.</div>
        </div>
        <div class="form-group" style="margin-bottom:0;">
          <label for="brandColor">Brand Color</label>
          <div style="display:flex;gap:0.75rem;align-items:center;">
            <input type="color" id="brandColor" name="brandColor" value="<%= it.settings.brandColor || '#f97316' %>" style="width:48px;height:36px;padding:2px;border-radius:6px;border:1px solid var(--border);background:none;cursor:pointer;" />
            <span style="font-size:0.85rem;color:var(--text-muted);">Used as the accent color on customer-facing documents</span>
          </div>
        </div>
      </fieldset>
      <% } else { %>
      <div style="background:var(--surface-2);border-radius:var(--radius);padding:1rem 1.25rem;border:1px solid var(--border);margin-bottom:1.25rem;">
        <div style="font-weight:600;margin-bottom:0.25rem;">Branding <span style="font-size:0.75rem;font-weight:500;color:var(--text-muted);background:var(--surface-3);padding:2px 8px;border-radius:99px;margin-left:0.4rem;">Pro</span></div>
        <div style="font-size:0.85rem;color:var(--text-muted);margin-bottom:0.75rem;">Add your shop logo and brand color to estimates and invoices.</div>
        <a href="/upgrade" class="btn btn-primary btn-sm">Upgrade to Pro</a>
      </div>
      <% } %>
      <div class="btn-group">
        <button type="submit" class="btn btn-primary">Save Settings</button>
      </div>
    </form>
    <% if (it.plan === 'paid') { %>
    <form method="POST" action="/admin/settings/reset-branding" style="margin-top:0.75rem;">
      <button type="submit" class="btn btn-ghost btn-sm" style="color:var(--danger);" onclick="return confirm('Reset all branding? This will remove your logo and brand color.')">Reset all branding</button>
    </form>
    <% } %>
    <hr class="divider" />
    <div style="display:flex;gap:0.75rem;flex-wrap:wrap;align-items:center;">
      <% if (it.isSuperAdmin) { %>
      <a href="/superadmin/accounts" class="btn btn-ghost btn-sm">&#128101; Accounts</a>
      <% } %>
      <a href="/admin/share" class="btn btn-ghost btn-sm">&#128279; Share App</a>
      <a href="/admin/account" class="btn btn-ghost btn-sm">&#128274; Account &amp; Privacy</a>
      <a href="/logout" class="btn btn-ghost btn-sm">&#8592; Sign out</a>
    </div>
  </div>
</div>
