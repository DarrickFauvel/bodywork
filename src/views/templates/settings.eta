<div class="page-header">
  <div>
    <div class="page-title">Settings</div>
    <div class="page-subtitle">Shop information &amp; defaults</div>
  </div>
</div>
<div class="page-body">
  <div style="max-width:540px;">
    <form method="POST" action="/admin/settings" enctype="multipart/form-data">
      <fieldset class="card" style="border:1px solid var(--border);">
        <legend class="card-title" style="padding:0 0.5rem;background:transparent;">Shop Info</legend>
        <div class="form-group">
          <label for="shopName">Shop Name</label>
          <input type="text" id="shopName" name="shopName" value="<%= it.settings.shopName || '' %>" placeholder="My Auto Body Shop" />
        </div>
        <div class="form-row">
          <div class="form-group">
            <label for="phone">Phone</label>
            <input type="tel" id="phone" name="phone" value="<%= it.settings.phone || '' %>" />
          </div>
          <div class="form-group">
            <label for="email">Email</label>
            <input type="email" id="email" name="email" value="<%= it.settings.email || '' %>" />
          </div>
        </div>
        <div class="form-group" style="margin-bottom:0;">
          <label for="address">Address</label>
          <input type="text" id="address" name="address" value="<%= it.settings.address || '' %>" />
        </div>
      </fieldset>
      <fieldset class="card" style="border:1px solid var(--border);">
        <legend class="card-title" style="padding:0 0.5rem;background:transparent;">Defaults</legend>
        <div class="form-row" style="margin-bottom:0;">
          <div class="form-group" style="margin-bottom:0;">
            <label for="defaultLaborRate">Default Labor Rate ($/hr)</label>
            <input type="number" id="defaultLaborRate" name="defaultLaborRate" step="0.01" min="0"
              value="<%= it.settings.defaultLaborRate ?? 95 %>" />
          </div>
          <div class="form-group" style="margin-bottom:0;">
            <label for="defaultTaxRate">Default Tax Rate (%)</label>
            <input type="number" id="defaultTaxRate" name="defaultTaxRate" step="0.01" min="0" max="100" placeholder="0.00"
              value="<%= ((it.settings.defaultTaxRate ?? 0) * 100).toFixed(2) %>" />
          </div>
        </div>
      </fieldset>
      <% if (it.plan === 'paid') { %>
      <fieldset class="card" style="border:1px solid var(--border);">
        <legend class="card-title" style="padding:0 0.5rem;background:transparent;">Branding</legend>
        <div class="form-group">
          <label>Shop Logo</label>
          <% if (it.settings.logoData) { %>
          <div id="logo-current" style="position:relative;display:inline-block;margin-bottom:0.75rem;">
            <img src="<%= it.settings.logoData %>" alt="Shop logo" style="max-height:80px;max-width:220px;border-radius:6px;border:1px solid var(--border);display:block;" />
            <button type="button" id="logo-remove-btn" onclick="removeLogo()" aria-label="Remove logo"
              style="position:absolute;top:-8px;right:-8px;width:22px;height:22px;border-radius:50%;background:var(--danger);color:#fff;border:none;cursor:pointer;font-size:0.85rem;line-height:1;display:flex;align-items:center;justify-content:center;padding:0;">&#x2715;</button>
          </div>
          <div style="margin-bottom:0.5rem;">
            <input type="file" id="logo-input" name="logo" accept="image/*" onchange="handleLogoChange(this)" />
          </div>
          <% } else { %>
          <input type="file" id="logo-input" name="logo" accept="image/*" onchange="handleLogoChange(this)" />
          <% } %>
          <div id="logo-preview" style="display:none;margin-top:0.75rem;">
            <img id="logo-preview-img" src="" alt="Logo preview" style="max-height:80px;max-width:220px;border-radius:6px;border:1px solid var(--border);" />
            <div style="font-size:0.75rem;color:var(--text-muted);margin-top:0.25rem;">Preview — save to apply</div>
          </div>
          <div style="font-size:0.75rem;color:var(--text-muted);margin-top:0.25rem;">PNG, JPG, or SVG. Displayed on estimates and invoices.</div>
        </div>
        <div class="form-group">
          <label for="brandColor">Brand Color</label>
          <div style="display:flex;gap:0.75rem;align-items:center;">
            <input type="color" id="brandColor" name="brandColor" value="<%= it.settings.brandColor || '#f97316' %>" style="width:48px;height:36px;padding:2px;border-radius:6px;border:1px solid var(--border);background:none;cursor:pointer;" onchange="saveBrandColor(this)" />
            <span style="font-size:0.85rem;color:var(--text-muted);">Used as the accent color on customer-facing documents</span>
          </div>
        </div>
        <div style="margin-bottom:0;text-align:right;">
          <button type="button" class="btn btn-ghost btn-sm" style="color:var(--danger);" onclick="document.getElementById('confirm-reset-branding').showModal()">Reset branding</button>
        </div>
      </fieldset>
      <% } else { %>
      <div class="card" style="background:var(--surface-2);">
        <div style="font-weight:600;margin-bottom:0.25rem;">Branding <span style="font-size:0.75rem;font-weight:500;color:var(--text-muted);background:var(--surface-3);padding:2px 8px;border-radius:99px;margin-left:0.4rem;">Pro</span></div>
        <div style="font-size:0.85rem;color:var(--text-muted);margin-bottom:0.75rem;">Add your shop logo and brand color to estimates and invoices.</div>
        <a href="/upgrade" class="btn btn-primary btn-sm">Upgrade to Pro</a>
      </div>
      <% } %>
      <div class="btn-group">
        <button type="submit" class="btn btn-primary">Save Settings</button>
      </div>
    </form>
    <% if (it.plan === 'paid') { %>
    <form id="reset-branding-form" method="POST" action="/admin/settings/reset-branding"></form>
    <dialog id="confirm-reset-branding">
      <h3>Reset branding?</h3>
      <p>This will permanently remove your logo and brand color.</p>
      <div class="btn-group">
        <button type="button" class="btn btn-ghost btn-sm" onclick="document.getElementById('confirm-reset-branding').close()">Cancel</button>
        <button type="submit" form="reset-branding-form" class="btn btn-danger btn-sm">Reset branding</button>
      </div>
    </dialog>
    <% } %>
    <script>
    function showToast(msg) {
      let el = document.getElementById('settings-toast')
      if (!el) {
        el = document.createElement('div')
        el.id = 'settings-toast'
        el.className = 'toast'
        document.body.appendChild(el)
      }
      el.textContent = msg
      el.classList.add('show')
      clearTimeout(el._t)
      el._t = setTimeout(() => el.classList.remove('show'), 3000)
    }

    async function handleLogoChange(input) {
      if (!input.files || !input.files[0]) return
      const file = input.files[0]
      const preview = document.getElementById('logo-preview')
      const img = document.getElementById('logo-preview-img')
      const current = document.getElementById('logo-current')
      const hint = preview.nextElementSibling

      img.src = URL.createObjectURL(file)
      preview.style.display = 'block'
      if (current) current.style.display = 'none'
      if (hint) hint.textContent = 'Uploading…'

      const fd = new FormData()
      fd.append('logo', file)
      const res = await fetch('/admin/settings/logo', { method: 'POST', body: fd })
      if (res.ok) {
        const { logoUrl } = await res.json()
        img.src = logoUrl
        if (hint) hint.textContent = 'PNG, JPG, or SVG. Displayed on estimates and invoices.'
        input.value = ''
        showToast('Logo saved')
      } else {
        preview.style.display = 'none'
        if (current) current.style.display = 'block'
        if (hint) hint.textContent = 'Upload failed — try again'
      }
    }

    async function removeLogo() {
      const res = await fetch('/admin/settings/remove-logo', { method: 'POST' })
      if (res.ok) {
        document.getElementById('logo-current')?.remove()
        showToast('Logo removed')
      }
    }

    async function saveBrandColor(input) {
      const fd = new FormData()
      fd.append('brandColor', input.value)
      const res = await fetch('/admin/settings/brand-color', { method: 'POST', body: fd })
      if (res.ok) showToast('Brand color saved')
    }

    if (new URLSearchParams(location.search).get('saved')) {
      history.replaceState(null, '', location.pathname)
      showToast('Settings saved')
    }
    </script>
    <hr class="divider" />
    <div style="display:flex;gap:0.75rem;flex-wrap:wrap;align-items:center;">
      <% if (it.isSuperAdmin) { %>
      <a href="/superadmin/accounts" class="btn btn-ghost btn-sm">&#128101; Accounts</a>
      <% } %>
      <a href="/admin/share" class="btn btn-ghost btn-sm">&#128279; Share App</a>
      <a href="/admin/account" class="btn btn-ghost btn-sm">&#128274; Account &amp; Privacy</a>
      <a href="/logout" class="btn btn-ghost btn-sm">&#8592; Sign out</a>
    </div>
  </div>
</div>
