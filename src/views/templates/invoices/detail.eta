<% const vehicle = it.vehicle %>
<% const inv = it.invoice %>
<% const shareUrl = it.shareUrl %>

<div data-signals='{"toast": "", "redirect": "", "editingDetails": false}'>
<div data-effect="if ($redirect) { window.location.href = $redirect }"></div>
<div data-show="$toast !== ''" style="position:fixed;bottom:1.5rem;right:1.5rem;z-index:9999;">
  <div class="toast">
    <span data-text="$toast"></span>
    <button data-on:click="$toast = ''"
      style="background:none;border:none;color:var(--text-muted);cursor:pointer;margin-left:0.75rem;">✕</button>
  </div>
</div>

<div class="page-header">
  <div>
    <div class="page-title"><%= inv.title %></div>
    <div class="page-subtitle">
      <a href="/admin/invoices">← Invoices</a>
      &nbsp;·&nbsp;
      <a href="/admin/customers/<%= it.customer.id %>"><%= it.customer.name %></a>
      <% if (inv.estimateId) { %>
      &nbsp;·&nbsp; <a href="/admin/estimates/<%= inv.estimateId %>">View Estimate</a>
      <% } %>
    </div>
  </div>
  <div class="btn-group">
    <form method="POST" action="/admin/invoices/<%= inv.id %>/delete">
      <button type="submit" class="btn btn-danger btn-sm"
        onclick="return confirm('Delete this invoice?')">Delete</button>
    </form>
  </div>
</div>

<div class="page-body">
  <!-- Status Bar -->
  <div class="status-bar">
    <span id="status-badge"><status-badge status="<%= inv.status %>"></status-badge></span>
    <span class="text-muted" style="font-size:0.8rem;">Created <%= it.fmtDate(inv.createdAt) %></span>
    <% if (inv.dueDate) { %>
    <span class="text-muted" style="font-size:0.8rem;">Due <%= it.fmtDate(inv.dueDate) %></span>
    <% } %>
    <div class="btn-group" style="margin-left:auto;">
      <% if (inv.status === 'draft') { %>
      <button class="btn btn-sm btn-ghost"
        data-on:click="@post('/sse/invoices/<%= inv.id %>/status?action=send')">
        Send to Customer
      </button>
      <% } %>
      <% if (inv.status === 'sent') { %>
      <button class="btn btn-sm btn-success"
        data-on:click="@post('/sse/invoices/<%= inv.id %>/status?action=pay')">
        ✓ Mark Paid
      </button>
      <% } %>
    </div>
  </div>

  <% if (shareUrl) { %>
  <div class="share-link-box mb-2">
    <span>Customer link:</span>
    <code><%= shareUrl %></code>
    <copy-button class="btn btn-xs btn-ghost" text="<%= shareUrl %>">Copy</copy-button>
    <a href="<%= shareUrl %>" target="_blank" class="btn btn-xs btn-ghost">Preview ↗</a>
  </div>
  <% } %>

  <!-- Invoice Details: view / edit -->
  <div id="invoice-header" class="card">

    <!-- View mode -->
    <div data-show="!$editingDetails">
      <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:1rem;margin-bottom:0.75rem;">
        <div class="card-title" style="margin-bottom:0;">Invoice Details</div>
        <button type="button" class="btn btn-ghost btn-sm" data-on:click="$editingDetails = true">Edit</button>
      </div>
      <% const vParts = [vehicle.year, vehicle.make, vehicle.model].filter(Boolean) %>
      <div style="border:1px solid var(--border);border-radius:var(--radius);padding:0.85rem 1rem;margin-bottom:0.75rem;">
        <div class="card-title" style="margin-bottom:0.5rem;">Invoice</div>
        <dl class="detail-summary">
          <div><dt>Title</dt><dd><%= inv.title %></dd></div>
          <div><dt>Tax Rate</dt><dd><%= parseFloat((inv.taxRate * 100).toFixed(4)) %>%</dd></div>
          <% if (inv.dueDate) { %><div><dt>Due Date</dt><dd><%= it.fmtDate(inv.dueDate) %></dd></div><% } %>
          <% if (inv.notes) { %><div><dt>Notes</dt><dd style="white-space:pre-wrap;"><%= inv.notes %></dd></div><% } %>
        </dl>
      </div>
      <% if (vParts.length || vehicle.vin || vehicle.mileage) { %>
      <div style="border:1px solid var(--border);border-radius:var(--radius);padding:0.85rem 1rem;">
        <div class="card-title" style="margin-bottom:0.5rem;">Vehicle</div>
        <dl class="detail-summary">
          <% if (vParts.length) { %>
          <div><dt>Vehicle</dt><dd><%= vParts.join(' ') %><% if (vehicle.color) { %> · <%= vehicle.color %><% } %></dd></div>
          <% } %>
          <% if (vehicle.vin) { %><div><dt>VIN</dt><dd><%= vehicle.vin %></dd></div><% } %>
          <% if (vehicle.mileage) { %><div><dt>Mileage</dt><dd><%= vehicle.mileage %></dd></div><% } %>
        </dl>
      </div>
      <% } %>
    </div>

    <!-- Edit mode -->
    <div data-show="$editingDetails">
      <fieldset style="border:1px solid var(--border);border-radius:var(--radius);padding:1.25rem;margin-bottom:1rem;">
        <legend class="card-title" style="padding:0 0.5rem;background:transparent;">Invoice</legend>
        <div class="form-group">
          <label>Title</label>
          <input type="text" name="title" data-bind:title value="<%= inv.title %>" />
        </div>
        <div class="form-row">
          <div class="form-group">
            <label>Tax Rate (%)</label>
            <input type="number" name="taxRate" data-bind:taxRate step="0.01" min="0" max="100"
              value="<%= (inv.taxRate * 100).toFixed(2) %>" />
          </div>
          <div class="form-group">
            <label>Due Date</label>
            <input type="date" name="dueDate" data-bind:dueDate
              value="<%= inv.dueDate ? new Date(inv.dueDate).toISOString().split('T')[0] : '' %>" />
          </div>
        </div>
        <div class="form-group" style="margin-bottom:0;">
          <label>Notes</label>
          <textarea name="notes" data-bind:notes><%= inv.notes || '' %></textarea>
        </div>
      </fieldset>
      <fieldset style="border:1px solid var(--border);border-radius:var(--radius);padding:1.25rem;margin-bottom:1rem;">
        <legend class="card-title" style="padding:0 0.5rem;background:transparent;">Vehicle</legend>
        <div class="form-row">
          <div class="form-group">
            <label>Year</label>
            <input type="text" name="vYear" data-bind:vYear value="<%= vehicle.year || '' %>" />
          </div>
          <div class="form-group">
            <label>Make</label>
            <input type="text" name="vMake" data-bind:vMake value="<%= vehicle.make || '' %>" />
          </div>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label>Model</label>
            <input type="text" name="vModel" data-bind:vModel value="<%= vehicle.model || '' %>" />
          </div>
          <div class="form-group">
            <label>Color</label>
            <input type="text" name="vColor" data-bind:vColor value="<%= vehicle.color || '' %>" />
          </div>
        </div>
        <div class="form-row" style="margin-bottom:0;">
          <div class="form-group" style="margin-bottom:0;">
            <label>VIN</label>
            <input type="text" name="vVin" data-bind:vVin value="<%= vehicle.vin || '' %>" />
          </div>
          <div class="form-group" style="margin-bottom:0;">
            <label>Mileage</label>
            <input type="text" name="vMileage" data-bind:vMileage value="<%= vehicle.mileage || '' %>" />
          </div>
        </div>
      </fieldset>
      <div class="btn-group">
        <button class="btn btn-primary"
          data-on:click="$editingDetails = false; @post('/sse/invoices/<%= inv.id %>/save')">
          Save Changes
        </button>
        <button type="button" class="btn btn-ghost"
          data-on:click="$editingDetails = false">
          Cancel
        </button>
      </div>
    </div>

  </div>

  <!-- Line Items -->
  <div class="line-items-section">
    <div class="line-items-header">
      <h3 style="font-size:1rem;font-weight:700;">Line Items</h3>
    </div>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th style="width:75px;">Type</th>
            <th>Description</th>
            <th class="col-num">Detail</th>
            <th class="col-num">Subtotal</th>
            <th class="col-actions"></th>
          </tr>
        </thead>
        <tbody id="line-items-body">
          <%~ it.lineItemsHtml %>
        </tbody>
        <%~ it.totalsHtml %>
      </table>
    </div>

    <div class="add-item-wrap">
      <line-item-type-fields>
        <div class="add-item-row">
          <div class="form-group">
            <label>Type</label>
            <select name="newType" data-bind:newType style="width:110px;">
              <option value="labor">Labor</option>
              <option value="parts">Parts</option>
              <option value="paint">Paint</option>
              <option value="sublet">Sublet</option>
            </select>
          </div>
          <div class="form-group" style="flex:2;">
            <label>Description</label>
            <input type="text" name="newDesc" data-bind:newDesc placeholder="Description..." />
          </div>
          <div data-for-type="labor" class="form-group">
            <label>Hours</label>
            <input type="number" name="newHours" data-bind:newHours step="0.5" min="0" style="width:80px;" />
          </div>
          <div data-for-type="labor" class="form-group">
            <label>Rate/hr ($)</label>
            <input type="number" name="newRate" data-bind:newRate step="0.01" min="0" style="width:90px;"
              value="<%= it.settings.defaultLaborRate %>" />
          </div>
          <div data-for-type="parts,paint" class="form-group">
            <label>Part #</label>
            <input type="text" name="newPartNum" data-bind:newPartNum style="width:100px;" placeholder="Optional" />
          </div>
          <div data-for-type="parts,paint" class="form-group">
            <label>Qty</label>
            <input type="number" name="newQty" data-bind:newQty step="0.01" min="0" style="width:70px;" value="1" />
          </div>
          <div data-for-type="parts,paint" class="form-group">
            <label>Unit Price ($)</label>
            <input type="number" name="newUnitPrice" data-bind:newUnitPrice step="0.01" min="0" style="width:90px;" />
          </div>
          <div data-for-type="sublet" class="form-group">
            <label>Flat Price ($)</label>
            <input type="number" name="newFlat" data-bind:newFlat step="0.01" min="0" style="width:100px;" />
          </div>
          <div class="form-group">
            <label>&nbsp;</label>
            <button class="btn btn-primary"
              data-on:click="@post('/sse/invoices/<%= inv.id %>/line-items')">
              + Add
            </button>
          </div>
        </div>
      </line-item-type-fields>
    </div>
  </div>
</div><!-- /data-signals -->
