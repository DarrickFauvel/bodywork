<div class="page-header">
  <div>
    <div class="page-title">Account &amp; Privacy</div>
    <div class="page-subtitle">Your data, your rights</div>
  </div>
</div>
<div class="page-body">

  <div class="card" style="max-width:540px;margin-bottom:1.5rem;">
    <div class="card-title">Account</div>
    <div style="font-size:0.875rem;color:var(--text-muted);margin-bottom:0.5rem;">Signed in as</div>
    <div style="font-size:0.95rem;font-weight:600;margin-bottom:1.5rem;"><%= it.user.email %></div>

    <div class="card-title" style="font-size:0.85rem;margin-bottom:0.75rem;">Export Your Data</div>
    <p style="font-size:0.875rem;color:var(--text-muted);margin-bottom:1rem;line-height:1.6;">
      Download a copy of all your data — account info, customers, estimates, invoices, and line items — as a JSON file.
    </p>
    <a href="/admin/account/export" class="btn btn-ghost btn-sm">&#8595; Download data export</a>
  </div>

  <div class="card" style="max-width:540px;border-color:var(--danger);">
    <div class="card-title" style="color:var(--danger);">Delete Account</div>
    <p style="font-size:0.875rem;color:var(--text-muted);margin-bottom:1.25rem;line-height:1.6;">
      Permanently deletes your account and <strong>all associated data</strong> — customers, estimates, invoices, line items, and settings.
      This cannot be undone. Export your data first if you need a copy.
    </p>
    <% if (it.error) { %>
    <div class="error-msg" style="margin-bottom:1rem;"><%= it.error %></div>
    <% } %>
    <form method="POST" action="/admin/account/delete">
      <div class="form-group">
        <label for="confirmation">Type your email address to confirm: <strong><%= it.user.email %></strong></label>
        <input type="email" id="confirmation" name="confirmation"
          placeholder="<%= it.user.email %>" required autocomplete="off" />
      </div>
      <button type="submit" class="btn btn-danger">Permanently Delete My Account</button>
    </form>
  </div>

  <div style="margin-top:1.5rem;font-size:0.8rem;color:var(--text-muted);">
    <a href="/privacy" target="_blank" style="color:var(--text-muted);">Privacy Policy</a>
    &middot;
    <a href="/admin/settings" style="color:var(--text-muted);">Back to Settings</a>
  </div>

</div>
